---
import Layout from '../../layouts/Layout.astro';
import { CHAPTERS, LANGS, PARTS, type Chapter, type Lang } from '../../data/chapters';
import { UI, htmlLang } from '../../i18n/ui';
import { chapterUrl, homeUrl } from '../../lib/paths';
import { sectionHtml } from '../../lib/report';

import Ch01 from '../../lessons/Ch01.astro';
import Ch02 from '../../lessons/Ch02.astro';
import Ch03 from '../../lessons/Ch03.astro';
import Ch04 from '../../lessons/Ch04.astro';
import Ch05 from '../../lessons/Ch05.astro';
import Ch06 from '../../lessons/Ch06.astro';
import Ch07 from '../../lessons/Ch07.astro';
import Ch08 from '../../lessons/Ch08.astro';
import Ch09 from '../../lessons/Ch09.astro';
import Ch10 from '../../lessons/Ch10.astro';
import Ch11 from '../../lessons/Ch11.astro';
import Ch12 from '../../lessons/Ch12.astro';
import Ch13 from '../../lessons/Ch13.astro';
import Ch14 from '../../lessons/Ch14.astro';
import Ch15 from '../../lessons/Ch15.astro';
import Ch16 from '../../lessons/Ch16.astro';
import Ch17 from '../../lessons/Ch17.astro';
import Ch18 from '../../lessons/Ch18.astro';

const LESSONS = { 1: Ch01, 2: Ch02, 3: Ch03, 4: Ch04, 5: Ch05, 6: Ch06, 7: Ch07, 8: Ch08, 9: Ch09, 10: Ch10, 11: Ch11, 12: Ch12, 13: Ch13, 14: Ch14, 15: Ch15, 16: Ch16, 17: Ch17, 18: Ch18 } as const;

export function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    CHAPTERS.map((chapter) => ({ params: { lang, slug: chapter.slug[lang] }, props: { chapter } })),
  );
}

interface Props {
  chapter: Chapter;
}
const { chapter } = Astro.props;
const lang = Astro.params.lang as Lang;
const other: Lang = lang === 'en' ? 'pt' : 'en';
const t = UI[lang];
const part = PARTS[chapter.part - 1];
const prev = CHAPTERS.find((c) => c.id === chapter.id - 1);
const next = CHAPTERS.find((c) => c.id === chapter.id + 1);
const Lesson = LESSONS[chapter.id as keyof typeof LESSONS];
const fullHtml = sectionHtml(lang, chapter.id);
const site = Astro.site!;
const pageUrl = new URL(chapterUrl(lang, chapter), site).href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': ['LearningResource', 'Article'],
    headline: chapter.title[lang],
    name: chapter.title[lang],
    description: chapter.description[lang],
    inLanguage: htmlLang(lang),
    url: pageUrl,
    timeRequired: `PT${chapter.minutes}M`,
    learningResourceType: 'Interactive lesson',
    educationalLevel: 'Professional',
    isAccessibleForFree: true,
    position: chapter.id,
    isPartOf: { '@type': 'Course', name: t.siteName, url: new URL(homeUrl(lang), site).href },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.siteName, item: new URL(homeUrl(lang), site).href },
      { '@type': 'ListItem', position: 2, name: `${t.part} ${part.id} · ${part.title[lang]}` },
      { '@type': 'ListItem', position: 3, name: chapter.short[lang], item: pageUrl },
    ],
  },
];
---

<Layout
  lang={lang}
  title={chapter.title[lang]}
  description={chapter.description[lang]}
  path={chapterUrl(lang, chapter)}
  altPath={chapterUrl(other, chapter)}
  type="article"
  jsonLd={jsonLd}
  accent={part.accent}
  chapterId={chapter.id}
>
  <!-- Chapter hero -->
  <header class="relative overflow-hidden pt-36 pb-20 sm:pt-44 sm:pb-28">
    <div class="aurora" aria-hidden="true"></div>
    <span class="outline-number pointer-events-none absolute -top-6 right-[-2vw] font-serif text-[clamp(14rem,34vw,30rem)] leading-none opacity-60 select-none" data-parallax="0.35" aria-hidden="true">
      {String(chapter.id).padStart(2, '0')}
    </span>
    <div class="relative container-x">
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 font-mono text-xs text-zinc-500" data-reveal>
        <a href={homeUrl(lang)} class="hover:text-white">{t.home}</a>
        <span aria-hidden="true">/</span>
        <span>{t.part} {part.id} · {part.title[lang]}</span>
        <span aria-hidden="true">/</span>
        <span class="text-[var(--accent)]">{t.chapter} {chapter.id}</span>
      </nav>
      <h1 class="display mt-8 max-w-5xl text-[clamp(2.6rem,6.5vw,6rem)]" data-split>{chapter.title[lang]}</h1>
      <p class="lead mt-8 max-w-2xl" data-reveal data-delay="0.3">{chapter.kicker[lang]}</p>
      <div class="mt-8 flex flex-wrap items-center gap-3" data-reveal data-delay="0.45">
        <span class="chip">⏱ {chapter.minutes} {t.minutes}</span>
        <span class="chip" data-progress-for={chapter.id}><span class="done-mark hidden">✓ {t.completed}</span><span class="todo-mark">{t.chapter} {chapter.id} / {CHAPTERS.length}</span></span>
      </div>
    </div>
  </header>

  <div class="hairline container-x" aria-hidden="true"></div>

  <Lesson lang={lang} />

  <!-- Full original text: complete, indexable, collapsible -->
  <section class="relative py-16">
    <div class="container-x">
      <details class="full-text glass overflow-hidden" data-reveal>
        <summary class="flex cursor-pointer items-center justify-between gap-6 p-6 sm:p-8">
          <span>
            <span class="block font-serif text-2xl text-white sm:text-3xl">{t.fullText}</span>
            <span class="mt-1 block text-sm text-zinc-400">{t.fullTextHint}</span>
          </span>
          <span class="chev grid h-10 w-10 shrink-0 place-items-center rounded-full border border-white/15 text-white transition duration-500" aria-hidden="true">⌄</span>
        </summary>
        <div class="border-t border-white/10 px-6 py-10 sm:px-12">
          <div class="rich mx-auto max-w-3xl" set:html={fullHtml} />
        </div>
      </details>
    </div>
  </section>

  <!-- Prev / next -->
  <nav id="chapter-end" class="relative pt-10 pb-24" aria-label={t.chapters}>
    <div class="container-x grid gap-4 md:grid-cols-2">
      {
        prev ? (
          <a href={chapterUrl(lang, prev)} class="glass spotlight group block p-7" style={`--accent:${PARTS[prev.part - 1].accent}`}>
            <span class="font-mono text-xs text-zinc-500">← {t.previous} · {String(prev.id).padStart(2, '0')}</span>
            <span class="mt-3 block font-serif text-3xl text-white transition group-hover:translate-x-[-4px]">{prev.short[lang]}</span>
          </a>
        ) : (
          <a href={homeUrl(lang)} class="glass spotlight group block p-7">
            <span class="font-mono text-xs text-zinc-500">← {t.home}</span>
            <span class="mt-3 block font-serif text-3xl text-white">{t.siteName}</span>
          </a>
        )
      }
      {
        next ? (
          <a href={chapterUrl(lang, next)} class="glass spotlight group block p-7 text-right" style={`--accent:${PARTS[next.part - 1].accent}`}>
            <span class="font-mono text-xs text-zinc-500">{t.next} · {String(next.id).padStart(2, '0')} →</span>
            <span class="mt-3 block font-serif text-3xl text-white transition group-hover:translate-x-1">{next.short[lang]}</span>
            <span class="mt-2 block text-sm text-zinc-400">{next.kicker[lang]}</span>
          </a>
        ) : (
          <a href={homeUrl(lang)} class="glass spotlight group block p-7 text-right">
            <span class="font-mono text-xs text-zinc-500">{t.home} →</span>
            <span class="mt-3 block font-serif text-3xl text-white">{t.siteName}</span>
          </a>
        )
      }
    </div>
  </nav>
</Layout>

<style is:global>
  [data-done='true'] .done-mark { display: inline; opacity: 1; }
  [data-done='true'] .todo-mark { display: none; }
</style>
