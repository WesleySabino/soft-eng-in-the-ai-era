---
/** A lesson block: numbered eyebrow, title, optional intro and the interactive content in the slot. */
interface Props {
  n?: string;
  label?: string;
  title: string;
  id?: string;
  wide?: boolean;
}
const { n, label, title, id, wide = false } = Astro.props;
---

<section id={id} class="relative scroll-mt-24 py-16 sm:py-24">
  <div class="container-x">
    <div class="max-w-3xl">
      <p class="eyebrow flex items-center gap-3" data-reveal>
        {n && <span class="text-zinc-500">{n}</span>}
        {n && <span class="h-px w-8 bg-current opacity-40" aria-hidden="true"></span>}
        <span>{label}</span>
      </p>
      <h2 class="display mt-4 text-4xl sm:text-5xl" data-split>{title}</h2>
      {Astro.slots.has('intro') && (
        <div class="rich mt-6" data-reveal>
          <slot name="intro" />
        </div>
      )}
    </div>
    <div class={`mt-10 ${wide ? '' : 'max-w-3xl'}`}>
      <slot />
    </div>
    {Astro.slots.has('after') && (
      <div class="rich mt-10 max-w-3xl" data-reveal>
        <slot name="after" />
      </div>
    )}
  </div>
</section>
