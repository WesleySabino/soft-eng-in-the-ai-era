---
/** A large statement whose words light up as the reader scrolls. */
interface Props {
  label?: string;
}
const { label } = Astro.props;
---

<section class="relative py-24 sm:py-32">
  <div class="container-x">
    {label && <p class="eyebrow" data-reveal>{label}</p>}
    <p class="display mt-6 text-[clamp(1.9rem,4.2vw,3.6rem)] leading-[1.12]" data-scrub><slot /></p>
  </div>
</section>
